# ─────────────────────────────────────────────
# Cova Task Manager - Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and adjust values

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cova_tasks
MYSQL_USER=cova_user
MYSQL_PASSWORD=cova_pass

# JWT
JWT_SECRET=your-super-secret-key-at-least-256-bits-long-here

# Frontend (Vite)
VITE_API_URL=http://localhost:8080